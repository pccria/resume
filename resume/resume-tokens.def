% Shared design tokens for Pooria Askari Moqaddam's CV/Resume
% Used by both resume.cls (English / pdflatex) and resume_fa.cls (Persian / xelatex)

%----------------------------------------------------------------------------------------
%	PAGE GEOMETRY & MARGINS
%----------------------------------------------------------------------------------------

\usepackage{geometry}
\geometry{
	top=24pt,
	bottom=24pt,
	left=48pt,
	right=48pt,
	nohead,
	nofoot,
}

\pagestyle{empty}

%----------------------------------------------------------------------------------------
%	COLOR PALETTE
%----------------------------------------------------------------------------------------

\usepackage[dvipsnames]{xcolor}
\definecolor{pantonegray}{RGB}{66, 67, 72}
\definecolor{darkgray}{RGB}{52, 52, 52}
\definecolor{bluegray}{RGB}{74, 97, 113}
\definecolor{background}{RGB}{236, 233, 225}

%----------------------------------------------------------------------------------------
%	TIKZ & VISUAL PRIMITIVES
%----------------------------------------------------------------------------------------

\usepackage{tikz}
\usetikzlibrary{shapes, positioning}

% Bullet point circle for lists
\newcommand{\pdot}[1][1pt]{%
    \tikz\draw[fill=pantonegray,draw=pantonegray] (0,0) circle (#1);%
}
